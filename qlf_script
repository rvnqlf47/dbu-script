StatsReaderTab:CreateSection("Stats")

local strengthLabel  = StatsReaderTab:CreateLabel("Strength : ?")
local speedLabel     = StatsReaderTab:CreateLabel("Speed : ?")
local defenseLabel   = StatsReaderTab:CreateLabel("Defense : ?")
local energyLabel    = StatsReaderTab:CreateLabel("Energy : ?")
local rebirthLabel   = StatsReaderTab:CreateLabel("Rebirths : ?")

StatsReaderTab:CreateButton({
    Name = "View Stats",
    Callback = function()
        local target = Players:FindFirstChild(selectedStatsPlayer)
        if not target then
            Rayfield:Notify({
                Title = "Error",
                Content = "Player not found.",
                Duration = 3,
            })
            return
        end

        local leaderstats = target:FindFirstChild("leaderstats")
        local statsFolder = target:FindFirstChild("Stats")
            or target:FindFirstChild("PlayerStats")
            or target:FindFirstChild("Data")

        local function getStat(...)
            for _, folder in ipairs({statsFolder, leaderstats}) do
                if folder then
                    for _, name in ipairs({...}) do
                        local val = folder:FindFirstChild(name)
                        if val then return tostring(val.Value) end
                    end
                end
            end
            return "?"
        end

        local strength = getStat("Strength", "Force", "STR", "Attack")
        local speed    = getStat("Speed", "Vitesse", "SPD", "WalkSpeed")
        local defense  = getStat("Defense", "DEF", "Defence")
        local energy   = getStat("Energy", "Energie", "Ki", "ENG", "MaxKi")
        local rebirths = getStat("Rebirths", "Rebirth", "Prestige")

        strengthLabel:Set("Strength : " .. strength)
        speedLabel:Set("Speed : "       .. speed)
        defenseLabel:Set("Defense : "   .. defense)
        energyLabel:Set("Energy : "     .. energy)
        rebirthLabel:Set("Rebirths : "  .. rebirths)
    end,
})

