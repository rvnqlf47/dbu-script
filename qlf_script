-- ========================
--  ESP FUNCTIONS
-- ========================
local espEnabled = false
local espBoxes   = {}
local rainbowHue = 0

local function clearESP()
    for _, box in pairs(espBoxes) do
        for _, line in pairs(box) do
            if line then line:Remove() end
        end
    end
    espBoxes = {}
end

local function getBox(character)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local sp, onScreen = camera:WorldToViewportPoint(root.Position)
    if not onScreen then return nil end
    local s = 40
    return sp.X - s, sp.Y - s, sp.X + s, sp.Y + s
end

local function createBox()
    local box = {}
    for _, name in pairs({"top","bottom","left","right"}) do
        local l = Drawing.new("Line")
        l.Thickness = 2
        l.Visible = false
        box[name] = l
    end
    return box
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    rainbowHue = (rainbowHue + 1/180) % 1
    local color = Color3.fromHSV(rainbowHue, 1, 1)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            if not espBoxes[p.Name] then espBoxes[p.Name] = createBox() end
            local box = espBoxes[p.Name]
            local minX, minY, maxX, maxY = getBox(p.Character)
            if minX then
                box.top.From    = Vector2.new(minX, minY) ; box.top.To    = Vector2.new(maxX, minY)
                box.bottom.From = Vector2.new(minX, maxY) ; box.bottom.To = Vector2.new(maxX, maxY)
                box.left.From   = Vector2.new(minX, minY) ; box.left.To   = Vector2.new(minX, maxY)
                box.right.From  = Vector2.new(maxX, minY) ; box.right.To  = Vector2.new(maxX, maxY)
                for _, l in pairs(box) do l.Color = color ; l.Visible = true end
            else
                for _, l in pairs(box) do l.Visible = false end
            end
        end
    end
    for name, box in pairs(espBoxes) do
        if not Players:FindFirstChild(name) then
            for _, l in pairs(box) do l:Remove() end
            espBoxes[name] = nil
        end
    end
end)
